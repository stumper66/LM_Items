<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.stumper66</groupId>
    <artifactId>LM_Items</artifactId>
    <version>1.3.4</version>
    <packaging>jar</packaging>

    <name>LM_Items</name>
    <description>Allows custom items in custom drops for LevelledMobs</description>
    <url>https://github.com/stumper66/LM_Items</url>

    <licenses>
        <license>
            <name>GNU AGPL v3.0</name>
            <url>https://www.gnu.org/licenses/agpl-3.0.en.html</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>stumper66</name>
            <url>https://github.com/stumper66</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/stumper66/LM_Items</url>
    </scm>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>

        <!-- Pin versions in one spot -->
        <ver.oraxen>1.166.0</ver.oraxen>
        <ver.paper>1.20.4-R0.1-SNAPSHOT</ver.paper>
        <ver.codex>1.1.1-R0.3</ver.codex>
        <ver.divinity>1.0.0-R1</ver.divinity>
        <ver.itemedit>2.17</ver.itemedit>
        <ver.cwp>release-1.0.1</ver.cwp>
        <ver.nightcore>2.7.12</ver.nightcore>
        <ver.excellentcrates>6.2.1</ver.excellentcrates>
        <ver.coinsengine>2.5.0</ver.coinsengine>
        <ver.mythiclib>1.4</ver.mythiclib>
        <ver.mmoitems_api>6.7.3</ver.mmoitems_api>
        <ver.nexo>1.10.0</ver.nexo>
        <ver.wolfyutilities>3.16.1.0</ver.wolfyutilities>
        <ver.itemsadder>3.0.0</ver.itemsadder>
        <ver.eco>6.57.2</ver.eco>
        <ver.hdbapi>1.3.2</ver.hdbapi>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <sourceDirectory>src</sourceDirectory>

        <plugins>
            <plugin>
                <groupId>org.sonatype.plugins</groupId>
                <artifactId>nexus-staging-maven-plugin</artifactId>
                <version>1.6.13</version>
                <extensions>true</extensions>
                <configuration>
                    <serverId>ossrh</serverId>
                    <nexusUrl>https://s01.oss.sonatype.org/</nexusUrl>
                    <autoReleaseAfterClose>true</autoReleaseAfterClose>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.0</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals><goal>jar-no-fork</goal></goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals><goal>jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <resources>
            <resource>
                <directory>src/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>

    <repositories>
        <!-- Phoenix Plugin Repos -->
        <repository>
            <id>phoenix</id>
            <url>https://nexus.phoenixdevt.fr/repository/maven-public/</url>
        </repository>

        <!-- Paper & Spigot group -->
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
        </repository>

        <!-- Oraxen -->
        <repository>
            <id>oraxen</id>
            <url>https://repo.oraxen.com/releases</url>
        </repository>

        <!-- PhoenixDevT (Lumine ecosystem: MythicLib/MMOItems) -->
        <repository>
            <id>phoenixdevt</id>
            <url>https://nexus.phoenixdevt.fr/repository/maven-public/</url>
        </repository>

        <!-- Lumine public (historic MythicLib coordinates) -->
        <repository>
            <id>lumine</id>
            <url>https://mvn.lumine.io/repository/maven-public/</url>
        </repository>

        <!-- NightExpress (NightCore/ExcellentCrates/CoinsEngine) -->
        <repository>
            <id>nightexpress-releases</id>
            <url>https://repo.nightexpressdev.com/releases</url>
        </repository>

        <!-- WolfyUtilities -->
        <repository>
            <id>wolfyscript-public</id>
            <url>https://maven.wolfyscript.com/repository/public/</url>
        </repository>

        <!-- Nexo -->
        <repository>
            <id>nexomc-releases</id>
            <url>https://repo.nexomc.com/releases</url>
        </repository>
        <repository>
            <id>nexomc-snapshots</id>
            <url>https://repo.nexomc.com/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>

        <!-- Triumph GUI: Oraxen may pull 3.2.0-SNAPSHOT -->
        <repository>
            <id>triumph-snapshots</id>
            <url>https://repo.triumphteam.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>

        <!-- Libby (net.byteflux:libby-bukkit) -->
        <repository>
            <id>alessiodp</id>
            <url>https://repo.alessiodp.com/releases/</url>
        </repository>

        <!-- PlayerAnimator (com.ticxo:PlayerAnimator:R1.2.8) -->
        <repository>
            <id>mineinabyss</id>
            <url>https://repo.mineinabyss.com/releases</url>
        </repository>

        <!-- JeffMedia (MorePersistentDataTypes – also on Central, this is a backup) -->
        <repository>
            <id>jeff-media</id>
            <url>https://repo.jeff-media.com/public/</url>
        </repository>

        <!-- JitPack (for GitHub-only libs like ItemEdit/Custom-Item-Api, if you need them) -->
        <repository>
            <id>jitpack</id>
            <url>https://jitpack.io</url>
        </repository>

        <!-- Central -->
        <repository>
            <id>central</id>
            <url>https://repo.maven.apache.org/maven2/</url>
        </repository>

    </repositories>

    <dependencies>
        <!-- Basics -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>24.1.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>authlib</artifactId>
            <version>3.13.56</version>
            <scope>provided</scope>
        </dependency>

        <!-- Paper API -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${ver.paper}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Oraxen API -->
        <dependency>
            <groupId>io.th0rgal</groupId>
            <artifactId>oraxen</artifactId>
            <version>${ver.oraxen}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>com.jeff-media</groupId>
            <artifactId>MorePersistentDataTypes</artifactId>
            <version>2.4.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- Nexo -->
        <dependency>
            <groupId>com.nexomc</groupId>
            <artifactId>nexo</artifactId>
            <version>${ver.nexo}</version>
            <scope>provided</scope>
        </dependency>

        <!-- MythicMobs (dist) for events/hooks you already had -->
        <dependency>
            <groupId>io.lumine</groupId>
            <artifactId>Mythic-Dist</artifactId>
            <version>5.8.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- MythicLib + MMOItems API (replace old nomaven ones) -->
        <dependency>
            <groupId>io.lumine</groupId>
            <artifactId>MythicLib</artifactId>
            <version>${ver.mythiclib}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.Indyuce</groupId>
            <artifactId>MMOItems-API</artifactId>
            <version>${ver.mmoitems_api}</version>
            <scope>provided</scope>
        </dependency>

        <!-- NightExpress stack (replaces nightcore/excellentcrates/coins 'nomaven') -->
        <dependency>
            <groupId>su.nightexpress.nightcore</groupId>
            <artifactId>main</artifactId>
            <version>${ver.nightcore}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>su.nightexpress.excellentcrates</groupId>
            <artifactId>ExcellentCrates</artifactId>
            <version>${ver.excellentcrates}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>su.nightexpress.coinsengine</groupId>
            <artifactId>CoinsEngine</artifactId>
            <version>${ver.coinsengine}</version>
            <scope>provided</scope>
        </dependency>

        <!-- WolfyUtilities + (optionally) CustomCrafting -->
        <dependency>
            <groupId>com.wolfyscript.wolfyutilities</groupId>
            <artifactId>wolfyutilities</artifactId>
            <version>${ver.wolfyutilities}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ItemsAdder API -->
        <dependency>
            <groupId>com.github.LoneDev6</groupId>
            <artifactId>api-itemsadder</artifactId>
            <version>${ver.itemsadder}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Codex API (replaces ProMCCore) -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>codex-api</artifactId>
            <version>${ver.codex}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Divinity (replaces ProRPGItems) -->
        <dependency>
            <groupId>studio.magemonkey</groupId>
            <artifactId>divinity</artifactId>
            <version>${ver.divinity}</version>
            <scope>provided</scope>
        </dependency>

<!--        &lt;!&ndash; CombatWeaponryPlus via JitPack &ndash;&gt;-->
<!--        <dependency>-->
<!--            <groupId>com.github.DeskTecc</groupId>-->
<!--            <artifactId>Combat-weaponry-plus-plugin-minecraft</artifactId>-->
<!--            <version>${ver.cwp}</version>-->
<!--            <scope>provided</scope>-->
<!--        </dependency>-->

        <!-- ItemEdit via JitPack -->
        <dependency>
            <groupId>com.github.emanondev</groupId>
            <artifactId>ItemEdit</artifactId>
            <version>${ver.itemedit}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Custom Item API (JitPack) -->
        <dependency>
            <groupId>com.github.Senne98</groupId>
            <artifactId>Custom-Item-Api</artifactId>
            <version>Custom_Item_Api-5.5</version>
            <scope>provided</scope>
        </dependency>

        <!-- eco -->
        <dependency>
            <groupId>com.willfp</groupId>
            <artifactId>eco</artifactId>
            <version>${ver.eco}</version>
            <scope>provided</scope>
        </dependency>

        <!-- HeadDatabase API -->
        <dependency>
            <groupId>com.arcaniax</groupId>
            <artifactId>HeadDatabase-API</artifactId>
            <version>${ver.hdbapi}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <profiles>
        <profile>
            <id>release</id>
            <build/>
        </profile>
    </profiles>
</project>
